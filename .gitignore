# tvOS 独立仓忽略文件（仅 tvOS 构建产物）
build/
dist/
upstream/native/build/
# 内置站源模块的下载缓存（scripts/build_tvos.py）：模块仓库没有许可证，模块文件不入库
/build/modules/
tvos/DuanjuCore/*.xcframework/
tvos/DuanjuCore/DuanjuCore.variant
tvos/GuoAppTV/GuoAppTV/DuanjuCore.h
tvos/GuoAppTV/build/
*.log
__pycache__/
*.pyc
.DS_Store
.idea/
*.iml
.venv/
venv/
.pytest_cache/
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.p12
*.pfx
**/xcuserdata/
# 本机 Apple TV 部署参数（scripts/deploy_tvos.py --save 生成，含个人 Team ID）
tvos-deploy.local.json
# 纯逻辑测试包（tvos/Package.swift）的 SwiftPM 产物
tvos/.build/
tvos/.swiftpm/
